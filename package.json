{
  "name": "tunecompanion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/tokens"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "commitlint": "commitlint",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:generate": "npm run db:generate -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/web",
    "catalog:sync": "npm run catalog:sync -w apps/web",
    "test:sharing": "npm run test:sharing -w apps/web",
    "test:sets": "npm run test:sets -w apps/web",
    "test:emojis": "npm run test:emojis -w apps/web",
    "test:practice": "npm run test:practice -w apps/web",
    "test:popularity": "npm run test:popularity -w apps/web",
    "test:mcp": "npm run test:mcp -w apps/web",
    "guides:build": "npm run guides:build -w apps/web",
    "guides:seed": "npm run guides:seed -w apps/web"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3"
  }
}
