    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:sharing": "node --env-file=.env scripts/test-sharing.mjs",
    "test:sets": "node --env-file=.env scripts/test-sets.mjs",
    "test:emojis": "node --env-file=.env scripts/test-emojis.mjs",
