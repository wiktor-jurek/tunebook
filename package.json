    "emojilib": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
